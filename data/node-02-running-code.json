      "duration": 14.0,
      "text": "The process object.",
      "visual": "code",
      "items": [
        [
          "process.argv      // command-line args",
          "yellow"
        ],
        [
          "process.env.PORT  // environment vars",
          "green"
        ],
        [
          "process.cwd()      // working folder",
          "blue"
        ],
        [
          "process.exit(1)    // stop, with a code",
          "red"
        ],
        [
          "process.on('SIGINT', fn)",
          "pink"
        ]
      ],
      "say": "The process object is your window into the running program. It holds the command line arguments, environment variables, the current folder, and methods to exit with a status code, or react to signals like control C.",
