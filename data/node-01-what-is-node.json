      "id": "engine",
      "min": 9,
      "duration": 15.5,
      "text": "What's inside Node.",
      "visual": "flow",
      "badge": "V8 RUNS JS, LIBUV HANDLES I/O",
      "items": [
        [
          "Your JavaScript",
          "yellow",
          "the code you write"
