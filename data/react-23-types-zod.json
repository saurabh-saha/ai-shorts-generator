      "id": "gap",
      "min": 9,
      "duration": 11.5,
      "text": "TypeScript can't see runtime data.",
      "visual": "compare",
      "left": {
        "title": "TypeScript",
        "color": "yellow",
        "items": [
          "Checks at build time",
          "Types vanish at runtime"
        ]
      },
      "right": {
        "title": "Zod",
        "color": "green",
        "items": [
          "Checks real data at runtime",
          "Infers the TS type"
        ]
      },
      "say": "Types disappear when your code runs, so they can't check what an API actually returns. Zod validates real data at runtime, and gives you the TypeScript type from the same schema.",
      "voice": "/audio/react-23-types-zod/gap.wav"
    },
