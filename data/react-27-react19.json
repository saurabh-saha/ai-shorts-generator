          "red"
        ]
      ],
      "say": "use Optimistic shows the expected result immediately, while the server request is still in flight. If the request fails, the UI automatically rolls back to the real state.",
      "voice": "/audio/react-27-react19/optimistic.wav"
    },
    {
      "id": "use",
      "min": 9,
      "duration": 12.5,
      "text": "The use() API.",
      "visual": "code",
      "items": [
        [
          "// read a promise during render",
          "muted"
        ],
        [
          "const user = use(userPromise);",
          "yellow"
        ],
        [
          "",
          "text"
        ],
        [
          "// or read context, even conditionally",
          "muted"
        ],
        [
          "if (open) {",
          "blue"
        ],
        [
          "  const theme = use(ThemeContext);",
          "green"
        ],
        [
          "}",
          "blue"
        ]
      ],
      "say": "The use function reads a resource while rendering. Given a promise, it suspends until it resolves. Given a context, it reads the value, and unlike hooks, it can be called inside conditions.",
      "voice": "/audio/react-27-react19/use.wav"
    },
