        [
          "  await api.save(formData.get('name'));",
          "green"
        ],
        [
          "}",
          "yellow"
        ],
        [
          "",
          "text"
        ],
        [
          "<form action={save}>",
          "blue"
        ],
        [
          "  <input name=\"name\" />",
          "blue"
        ],
        [
          "  <button>Save</button>",
          "blue"
        ],
        [
          "</form>",
          "blue"
        ]
      ],
      "say": "In React nineteen, a form's action prop can be a function, even an async one. React calls it with the form data, tracks the pending state, and resets the form for you when it succeeds.",
      "voice": "/audio/react-27-react19/actions.wav"
    },
    {
      "id": "state",
      "min": 9,
      "duration": 11.5,
      "text": "useActionState.",
      "visual": "code",
      "items": [
        [
          "const [state, formAction, pending] =",
          "yellow"
        ],
        [
          "  useActionState(save, null);",
          "yellow"
        ],
        [
          "",
          "text"
        ],
        [
          "<form action={formAction}>",
          "blue"
        ],
        [
          "  <button disabled={pending}>",
          "green"
        ],
        [
          "    Save",
          "green"
        ],
        [
          "  </button>",
          "green"
        ],
        [
          "</form>",
          "blue"
        ]
      ],
      "say": "use Action State wraps an action, and gives you its latest result, such as validation errors, a wrapped action to pass to the form, and a pending flag, all in one hook.",
      "voice": "/audio/react-27-react19/state.wav"
    },
    {
      "id": "status",
      "min": 8,
      "duration": 10.5,
      "text": "useFormStatus.",
      "visual": "code",
      "items": [
        [
          "function SubmitButton() {",
          "yellow"
        ],
        [
          "  const { pending } = useFormStatus();",
          "blue"
        ],
        [
          "  return (",
          "muted"
        ],
        [
          "    <button disabled={pending}>Save</button>",
          "green"
        ],
        [
          "  );",
          "muted"
        ],
        [
          "}",
          "yellow"
        ]
      ],
      "say": "use Form Status lets any component inside a form read whether that form is submitting. A reusable submit button can disable itself, with no props passed down.",
      "voice": "/audio/react-27-react19/status.wav"
    },
    {
      "id": "optimistic",
      "min": 9,
      "duration": 11.0,
      "text": "useOptimistic.",
      "visual": "code",
      "badge": "SHOW THE RESULT BEFORE THE SERVER",
